# ── LLM Provider ─────────────────────────────────────────────────────────────
# Choose which provider to use: anthropic | openai | gemini
# Default is anthropic if not set.
LLM_PROVIDER=anthropic

# ── API Keys (set only the one matching your provider) ────────────────────────
ANTHROPIC_API_KEY=your_anthropic_key_here
OPENAI_API_KEY=your_openai_key_here
GOOGLE_API_KEY=your_google_ai_key_here

# ── Model Overrides (optional — defaults shown below) ─────────────────────────
# ANTHROPIC_MODEL=claude-sonnet-4-6
# OPENAI_MODEL=gpt-4o
# GEMINI_MODEL=gemini-1.5-pro

# ── Tavily Web Search (optional — enables evidence-grounded arguments) ────────
# Get a free API key at https://app.tavily.com
# Leave unset or empty to run without web search (agents will argue from training knowledge only).
TAVILY_API_KEY=your_tavily_key_here
# SEARCH_ENABLED=true          # set to "false" to disable without removing the key
# TAVILY_MAX_RESULTS=3         # results fetched per agent turn (default 3)
